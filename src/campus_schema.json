{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Campus (.cps)",
  "description": "Schema derive des exemples de fichiers .cps du projet. A remplacer par le schema officiel de l'autre systeme des qu'il est disponible.",
  "type": "object",
  "required": ["buildings", "name", "version"],
  "additionalProperties": false,
  "properties": {
    "buildings": {
      "type": "array",
      "items": { "$ref": "#/$defs/Building" }
    },
    "name": { "type": "string" },
    "version": { "type": "string" }
  },
  "$defs": {
    "Coordinates": {
      "type": "object",
      "required": ["x", "y", "z", "hash"],
      "additionalProperties": false,
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "z": { "type": "number" },
        "hash": { "type": "integer" }
      }
    },
    "Dimensions": {
      "type": "object",
      "required": ["width", "height", "hash"],
      "additionalProperties": false,
      "properties": {
        "width": { "type": "number" },
        "height": { "type": "number" },
        "hash": { "type": "integer" }
      }
    },
    "RoomManager": {
      "type": "object",
      "required": ["name", "telephoneNumber", "email"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "telephoneNumber": { "type": "string" },
        "email": { "type": "string" }
      }
    },
    "Room": {
      "type": "object",
      "required": [
        "id",
        "name",
        "dimensions",
        "location",
        "roomType",
        "access",
        "available",
        "capacity"
      ],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "integer" },
        "name": { "type": "string" },
        "oldName": { "type": "string" },
        "altName": { "type": "string" },
        "roomManagers": {
          "type": "object",
          "required": ["value"],
          "additionalProperties": false,
          "properties": {
            "value": {
              "type": "array",
              "items": { "$ref": "#/$defs/RoomManager" }
            }
          }
        },
        "access": {
          "type": "string",
          "enum": ["NONE", "FREE", "RESTRICTED", "CD"],
          "description": "Niveau d'accès de la salle. NONE = accès libre, non soumis à accréditation (équivalent métier de FREE). RESTRICTED = accès soumis à accréditation. CD = code spécifique à confirmer côté système source. Liste verrouillée sur les 4 valeurs confirmées à ce jour."
        },
        "available": { "type": "boolean" },
        "capacity": { "type": "integer", "minimum": 0 },
        "equipments": { "type": "array" },
        "roomBookingType": {
          "type": "string",
          "enum": ["PROJECT_DEDICATED", ""],
          "description": "Verrouillé volontairement sur les seules valeurs confirmées à ce jour (chaîne vide incluse, observée telle quelle). Même logique que roomType/type : toute valeur différente fera échouer la validation à l'intégration réelle, pour être détectée explicitement plutôt que passer inaperçue."
        },
        "comment": { "type": "string" },
        "zone": { "type": "string" },
        "roomType": {
          "type": "string",
          "enum": ["meetingRoom"],
          "description": "Verrouillé volontairement sur la seule valeur confirmée à ce jour. But recherché : toute salle avec un roomType différent fera échouer la validation lors de l'intégration avec un fichier réel, pour repérer explicitement les nouvelles valeurs à ajouter à cet enum plutôt que de les laisser passer silencieusement."
        },
        "telephoneNumber": { "type": "string" },
        "type": {
          "type": "string",
          "enum": ["NONE"],
          "description": "Verrouillé volontairement sur la seule valeur confirmée à ce jour. Même logique que roomType : toute valeur différente fera échouer la validation à l'intégration réelle, pour être détectée explicitement plutôt que passer inaperçue."
        },
        "dimensions": { "$ref": "#/$defs/Dimensions" },
        "location": { "$ref": "#/$defs/Coordinates" }
      }
    },
    "Floor": {
      "type": "object",
      "required": ["id", "name", "rooms", "points", "dimensions", "location"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "integer" },
        "name": { "type": "string" },
        "rooms": {
          "type": "array",
          "items": { "$ref": "#/$defs/Room" }
        },
        "points": {
          "type": "array",
          "description": "Liste plate [x1, y1, x2, y2, ...] formant le contour du plan. Doit contenir un nombre pair d'elements.",
          "items": { "type": "number" }
        },
        "zoneMarkers": { "type": "array" },
        "dimensions": { "$ref": "#/$defs/Dimensions" },
        "location": { "$ref": "#/$defs/Coordinates" }
      }
    },
    "Building": {
      "type": "object",
      "required": ["id", "name", "floors", "location"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "integer" },
        "name": { "type": "string" },
        "floors": {
          "type": "array",
          "items": { "$ref": "#/$defs/Floor" }
        },
        "location": { "$ref": "#/$defs/Coordinates" }
      }
    }
  }
}
